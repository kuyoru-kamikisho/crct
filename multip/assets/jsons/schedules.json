{
    "cmds": [
        {
            "id": "shutdown",
            "deleteAble": false,
            "name": "强制关机",
            "winCmd": "shutdown /s /t 0",
            "macCmd": "sudo shutdown -h now",
            "linuxCmd": "sudo systemctl poweroff -i"
        },
        {
            "id": "task",
            "deleteAble": false,
            "name": "打开任务管理器",
            "winCmd": "taskmgr",
            "macCmd": "open -a 'Activity Monitor'",
            "linuxCmd": "gnome-system-monitor || xfce4-task-manager || lxtask || open-system-monitor || xdg-open settings://system/about"
        },
        {
            "id": "setting",
            "deleteAble": false,
            "name": "打开控制面板",
            "winCmd": "control",
            "macCmd": "open -b com.apple.systempreferences",
            "linuxCmd": "xdg-open settings://system/about || gnome-control-center || unity-control-center || systemsettings5 || mate-control-center"
        }
    ],
