#pragma kernel CSMain

// 点数据结构体
struct PointData
{
    float3 pos;
    float3 color;
};

RWStructuredBuffer<PointData> pointBuffer;

float _Time;
float _GridSize;     // 网格行列数量
float _WaveSpeed;
float _WaveHeight;
float _WaveFreq;

[numthreads(8,8,1)]
void CSMain (uint3 id : SV_DispatchThreadID)
{
    uint idx = id.x + id.y * _GridSize;
    float u = id.x / float(_GridSize - 1);
    float v = id.y / float(_GridSize - 1);

    // 原始平面坐标 [-5,5]
    float3 p;
    p.x = (u - 0.5f) * 10;
    p.z = (v - 0.5f) * 10;

    // 二维正弦波函数，波浪动画
    float wave1 = sin(p.x * _WaveFreq + _Time * _WaveSpeed);
    float wave2 = sin(p.z * _WaveFreq + _Time * _WaveSpeed * 0.7f);
    p.y = (wave1 + wave2) * _WaveHeight;

    // 随坐标+时间做颜色渐变
    float c1 = sin(u * 3.1415 + _Time * 0.4);
    float c2 = cos(v * 3.1415 + _Time * 0.3);
    float c3 = sin((u+v)*2 + _Time * 0.2);
    float3 col = float3(c1,c2,c3)*0.5 + 0.5;

    pointBuffer[idx].pos = p;
    pointBuffer[idx].color = col;
}
